<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Ảnh nền -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_welcome"
        android:scaleType="centerCrop"
        android:contentDescription="Ảnh nền thực phẩm" />

    <!-- 2. Lớp phủ tối -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- 3. Nội dung chính -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♨"
            android:textSize="76sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- Tên ứng dụng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CookSmart"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="25dp" />

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nấu ngon\n từ những nguyên liệu\n sẵn có"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="18dp" />

        <!-- Mô tả -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khám phá công thức nấu ăn\nphù hợp với nguyên liệu bạn có"
            android:textSize="16sp"
            android:textColor="#EEEEEE"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="45dp" />

        <!-- Nút bắt đầu -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Bắt đầu"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#20A464"
            android:elevation="5dp" />

    </LinearLayout>

</FrameLayout>